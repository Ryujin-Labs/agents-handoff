---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import HandoffFlow from '../components/HandoffFlow.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
import { DOCS_URL, REPO_URL } from '../../../site.config.mjs';

const description =
  'Your coding agent writes a short, structured HANDOFF.md about the change you just finished. The other team’s agent reads it in their repository and knows what to change — and what not to build.';

// The README's example, so the page shows the format exactly as the tools write it. Prose
// lines are unwrapped here: the block wraps them itself.
const sample = `---
handoff_version: 1
id: 2026-08-28-auth-refresh-v2
created_at: 2026-08-28T18:20:00Z
status: ready
breaking: true
source:
  project: backend
  branch: feature/auth-refresh
  commit: 71ac931
targets: [mobile, web]
change_type: [api, authentication]
---

# Refresh tokens are now single-use

## Summary

\`POST /auth/refresh\` now returns a new \`refreshToken\` and invalidates the one you sent.

## Why This Matters

Clients that keep their original token get logged out mid-session the first time they refresh after this ships.

## Required Actions

### mobile

1. Read \`refreshToken\` from the refresh response and persist it in the keychain.
2. Replace the stored token atomically, in the same write as the access token.

## Instructions for Receiving Agent

Find the existing refresh path before writing anything. Modify it. Do not add a second token store, a new HTTP client, or a global retry interceptor.`;

const steps = [
  {
    title: 'Finish a change',
    body: 'Build it with your coding agent the way you already do. Nothing changes about how you work.',
  },
  {
    title: 'Ask for a handoff',
    quote: 'write a handoff for the mobile team',
    body: 'The tool gathers the facts from git — routes, auth guards, types, migrations, environment variables. Your agent writes what they mean for the other team, from what it knows about building the change with you.',
  },
  {
    title: 'Review it, then send it',
    body: 'You see the Required Actions before anything leaves. Pick a route — WhatsApp, email, Slack, Trello, a file — and press send yourself.',
  },
  {
    title: 'Their agent picks it up',
    quote: 'receive this handoff',
    body: 'It narrows the actions to their repository, searches their own code for what the change touches, and plans the work. It implements only when asked.',
  },
];

const principles = [
  {
    title: 'Facts from git, reasoning from your agent',
    body: 'The core never calls a model. It collects the change deterministically; the agent that built it with you explains what it means. Commit, branch and revision range are never retyped by hand.',
  },
  {
    title: 'Local-first',
    body: 'Writing, validating and receiving a handoff never touch the network. There is no server, no account and no telemetry — it runs where your code already is.',
  },
  {
    title: 'Nothing leaves without you',
    body: 'Your agent asks before it delivers, every time, and says who can read any link it creates. It never commits. Sending is always the last click, and it is yours.',
  },
  {
    title: 'A received handoff is data, not orders',
    body: 'Paths are confined to the project, credential-shaped strings are refused, and the receiving agent weighs the document against its own code instead of obeying it.',
  },
];

const channels = ['WhatsApp', 'Email', 'Slack', 'Discord', 'Trello', 'GitHub gist', 'File', 'Clipboard'];
const themes = { light: 'github-light', dark: 'github-dark' } as const;
---

<Base title="Agents Handoff — tell the next team's agent what your change means" description={description}>
  <Header />

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-copy">
          <span class="eyebrow">Open source · MIT · Local-first</span>
          <h1>Git says what changed.<br /><span class="accent">A handoff says what to do about it.</span></h1>
          <p class="lede">{description}</p>
          <div class="actions">
            <a class="btn btn-primary" href={`${DOCS_URL}/getting-started/`}>Get started</a>
            <a class="btn btn-secondary" href={REPO_URL}>View on GitHub</a>
          </div>
          <div class="install-line">
            <span class="install-label">In Claude Code</span>
            <CopyCommand command="/plugin marketplace add Ryujin-Labs/agents-handoff" />
            <CopyCommand command="/plugin install agents-handoff@agents-handoff" />
          </div>
        </div>
        <div class="hero-visual">
          <HandoffFlow />
        </div>
      </div>
    </section>

    <section class="section" id="why">
      <div class="container">
        <span class="eyebrow">The problem</span>
        <h2 class="section-title">The change is done. The message about it is where things break.</h2>
        <p class="section-lede">
          A pull request explains your code to your own team. The team that consumes it — mobile, web, devops, another
          service — gets a chat message, and an agent that knows none of what you know.
        </p>

        <div class="contrast">
          <div class="side before">
            <p class="side-label">What usually gets sent</p>
            <div class="bubble">
              heads up, refresh changed — tokens rotate now. update the app when you get a chance
            </div>
            <ul class="gaps">
              <li>Which endpoint, which field?</li>
              <li>What happens to users if mobile does nothing?</li>
              <li>Is it breaking, and from which release?</li>
              <li>What should their agent leave alone?</li>
            </ul>
          </div>
          <div class="side after">
            <p class="side-label">What a handoff sends</p>
            <div class="mini-doc">
              <p class="mini-title">Refresh tokens are now single-use <span class="tag">breaking</span></p>
              <p class="mini-h">Summary</p>
              <p><code>POST /auth/refresh</code> returns a new <code>refreshToken</code> and invalidates the old one.</p>
              <p class="mini-h">Why This Matters</p>
              <p>Clients that keep the old token are logged out on their next refresh.</p>
              <p class="mini-h">Required Actions · mobile</p>
              <ol>
                <li>Persist the new <code>refreshToken</code> in the keychain.</li>
                <li>Replace it in the same write as the access token.</li>
              </ol>
              <p class="mini-h">Instructions for Receiving Agent</p>
              <p>Modify the existing refresh path. No second token store.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="how">
      <div class="container">
        <span class="eyebrow">How it works</span>
        <h2 class="section-title">One request on each side.</h2>
        <p class="section-lede">
          No new workflow to learn: you ask your agent, it does the work, and you stay in control of what goes out.
        </p>
        <ol class="steps">
          {
            steps.map((step, index) => (
              <li class="step">
                <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                {step.quote && <p class="step-quote">“{step.quote}”</p>}
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" id="format">
      <div class="container format">
        <div class="format-copy">
          <span class="eyebrow">The format</span>
          <h2 class="section-title">A Markdown file with a contract on top.</h2>
          <p class="section-lede">
            <code>HANDOFF.md</code> is an open format: readable by people, parseable by tools, and small enough to read in two
            minutes.
          </p>
          <dl class="notes">
            <div>
              <dt>Frontmatter is the machine contract</dt>
              <dd>
                <code>breaking</code>, <code>targets</code> and <code>change_type</code> are required and never guessed. Commit,
                branch and revision come from git.
              </dd>
            </div>
            <div>
              <dt>Required Actions is what the receiver must do</dt>
              <dd>Numbered, written per target, and narrowed to the receiving repository when it arrives.</dd>
            </div>
            <div>
              <dt>Instructions for Receiving Agent is what not to build</dt>
              <dd>The guardrail that stops a well-meaning agent from adding a second token store.</dd>
            </div>
          </dl>
          <a class="more" href={`${DOCS_URL}/reference/spec/`}>Read the HANDOFF.md v1 specification →</a>
        </div>
        <div class="format-code">
          <Code code={sample} lang="md" themes={themes} wrap />
        </div>
      </div>
    </section>

    <section class="section" id="start">
      <div class="container start">
        <div>
          <span class="eyebrow">Get started</span>
          <h2 class="section-title">Use it where you already work.</h2>
          <p class="section-lede">
            Plugins for Claude Code and Codex, an MCP server for any other agent, and a CLI for humans and scripts. Requires
            Node.js 20.10 or later, and git.
          </p>
          <a class="more" href={`${DOCS_URL}/getting-started/`}>Full quick start →</a>
        </div>
        <Install />
      </div>
    </section>

    <section class="section" id="principles">
      <div class="container">
        <span class="eyebrow">Principles</span>
        <h2 class="section-title">Built to be trusted with unreleased work.</h2>
        <div class="principles">
          {
            principles.map((principle) => (
              <div class="principle">
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </div>
            ))
          }
        </div>
        <div class="channels">
          <p>Send it the way your team already talks:</p>
          <ul>
            {channels.map((channel) => <li>{channel}</li>)}
          </ul>
          <a class="more" href={`${DOCS_URL}/guides/delivery/`}>Delivery and privacy →</a>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container cta-inner">
        <h2>Write your first handoff in a minute.</h2>
        <p>Install the plugin, finish a change, and ask for a handoff. That is the whole setup.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`${DOCS_URL}/getting-started/`}>Read the quick start</a>
          <a class="btn btn-secondary" href={REPO_URL}>Star it on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero {
    padding: 88px 0 104px;
    background:
      radial-gradient(60% 50% at 50% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
      var(--bg);
  }

  .hero-copy {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  h1 {
    font-size: clamp(38px, 6.2vw, 68px);
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .accent {
    color: var(--accent-text);
  }

  .lede {
    margin: 24px auto 0;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--fg-muted);
    max-width: 60ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 36px;
  }

  .install-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 32px auto 0;
    max-width: 600px;
  }

  .install-line :global(.copy) {
    width: 100%;
  }

  .install-label {
    font: 500 12px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-faint);
  }

  .hero-visual {
    margin-top: 72px;
  }

  /* --- the problem ------------------------------------------------------------- */

  .contrast {
    margin-top: 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 24px;
  }

  .side {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    background: var(--bg-elevated);
  }

  .side-label {
    font: 600 12px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-faint);
    margin-bottom: 20px;
  }

  .before {
    background: var(--bg-sunken);
  }

  .bubble {
    display: inline-block;
    padding: 12px 16px;
    border-radius: 16px 16px 16px 4px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 15px;
    max-width: 34ch;
  }

  .gaps {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .gaps li {
    position: relative;
    padding-left: 28px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .gaps li::before {
    content: '?';
    position: absolute;
    left: 0;
    top: 1px;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: 700 11px/1 var(--font-mono);
    color: var(--warn);
    background: var(--warn-soft);
  }

  .after {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  .mini-doc {
    display: grid;
    gap: 6px;
    font-size: 15px;
  }

  .mini-doc ol {
    margin: 0;
    padding-left: 20px;
  }

  .mini-title {
    font-weight: 650;
    font-size: 17px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--warn-soft);
    color: var(--warn);
    font: 500 11px/1.4 var(--font-mono);
  }

  .mini-h {
    margin-top: 10px;
    font: 600 11px/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-text);
  }

  /* --- how it works ------------------------------------------------------------ */

  .steps {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .step {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .step-number {
    font: 600 13px/1 var(--font-mono);
    color: var(--accent-text);
  }

  .step h3 {
    font-size: 19px;
  }

  .step p {
    color: var(--fg-muted);
    font-size: 15px;
  }

  .step .step-quote {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
  }

  /* --- the format -------------------------------------------------------------- */

  .format {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 56px;
    align-items: start;
  }

  .notes {
    margin: 36px 0 0;
    display: grid;
    gap: 20px;
  }

  .notes div {
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }

  dt {
    font-weight: 650;
  }

  dd {
    margin: 4px 0 0;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .more {
    display: inline-block;
    margin-top: 28px;
    font-weight: 600;
  }

  .format-code :global(.astro-code) {
    font-size: 13px;
  }

  /* --- get started ------------------------------------------------------------- */

  .start {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 56px;
    align-items: center;
  }

  /* --- principles -------------------------------------------------------------- */

  .principles {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .principle {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  .principle h3 {
    font-size: 20px;
  }

  .principle p {
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .channels {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .channels p {
    color: var(--fg-muted);
    font-size: 15px;
  }

  .channels ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .channels li {
    padding: 4px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 14px;
    background: var(--bg-elevated);
  }

  .channels .more {
    margin-top: 0;
  }

  /* --- closing call to action -------------------------------------------------- */

  .cta {
    border-top: 1px solid var(--border);
    padding: 112px 0;
    text-align: center;
    background:
      radial-gradient(50% 60% at 50% 100%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
      var(--bg);
  }

  .cta h2 {
    font-size: clamp(30px, 4.5vw, 48px);
  }

  .cta p {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: 19px;
  }

  @media (max-width: 980px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .format,
    .start,
    .contrast {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 56px 0 72px;
    }
    .hero-visual {
      margin-top: 48px;
    }
    .steps,
    .principles {
      grid-template-columns: 1fr;
    }
    .side,
    .principle {
      padding: 22px;
    }
    .cta {
      padding: 80px 0;
    }
  }
</style>
